# Heavy, rarely-changing layer: Julia + Genie + a PackageCompiler sysimage.
# Built by GitHub Actions (.github/workflows/base-image.yml) and published to
# ghcr.io/edsonma/personal-landing-page-base, so app deploys on Railway only
# copy the page on top of it instead of recompiling Genie every time.
FROM julia:1.10-bookworm

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential && \
    rm -rf /var/lib/apt/lists/*

ENV JULIA_DEPOT_PATH=/usr/local/share/julia

COPY Project.toml ./
RUN julia --project=. -e 'using Pkg; Pkg.instantiate(); Pkg.add("PackageCompiler"); Pkg.precompile()'

COPY create_sysimage.jl ./
RUN julia --project=. create_sysimage.jl
